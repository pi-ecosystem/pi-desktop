{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Desktop",
  "version": "0.1.26",
  "identifier": "dev.pi.quickbar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": null,
    "windows": [
      {
        "label": "main",
        "title": "Pi",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480
      },
      {
        "label": "quickbar",
        "title": "Pi",
        "url": "quickbar.html",
        "width": 680,
        "height": 110,
        "minWidth": 480,
        "minHeight": 80,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}